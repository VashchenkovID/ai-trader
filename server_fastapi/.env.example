# Скопируйте в `.env` и подставьте секреты. Значения ниже — ориентир для локального бэкенда
# (включены основные интеграции и фоновые задачи; секреты оставлены пустыми/заглушками).

# --- Core ---
APP_NAME=ai-trader-fastapi
ENVIRONMENT=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO
SERVER_TIMEZONE=Europe/Moscow
ERROR_REGISTRY_PATH=./logs/error_registry.json
RUNTIME_ERROR_LOG_PATH=./logs/runtime_errors.jsonl
PORT=8000
FRONTEND_URL=http://localhost:5173

# --- Database & auth ---
# Локально: localhost и имя БД (например ai_trader или aitrader).
# Docker Compose: строка DATABASE_URL в контейнере задаётся в docker-compose.yml (хост postgres, не localhost);
# совпадение имён БД и пароля с контейнером postgres — через POSTGRES_* в .env у КОРНЯ репозитория, см. .env.docker.example
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_trader
USER_PASSWORD=admin
JWT_SECRET=change-me-development-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=7d

# --- Tinkoff Invest API ---
TINKOFF_API_URL=https://invest-public-api.tbank.ru/rest
# Песочница: https://sandbox-invest-public-api.tbank.ru/rest
TINKOFF_TOKEN=
TINKOFF_ACCOUNT_ID=
TINKOFF_VERIFY_SSL=true
TINKOFF_GRPC_URL=invest-public-api.tinkoff.ru:443
TINKOFF_SANDBOX=false
TINKOFF_USE_GRPC=false
TINKOFF_SCHEDULER_ENABLED=true
TINKOFF_PORTFOLIO_SYNC_CRON=*/15 * * * *
TINKOFF_INSTRUMENTS_CRON=0 */2 * * *
TINKOFF_PRICES_CRON=0 */1 * * *

# --- Background jobs (cron) — data / cache / market ---
CACHE_UPDATE_CRON=0 */2 * * *
CACHE_FULL_UPDATE_CRON=0 3 * * *
MARKET_REFRESH_CRON=*/30 * * * *
ASSETS_SYNC_CRON=0 4 * * *
FUNDAMENTAL_SYNC_CRON=0 2 1,15 * *
MACRO_UPDATE_CRON=0 10 * * *
SIGNALS_UPDATE_CRON=0 6 * * *
OPTIONS_UPDATE_CRON=0 7 * * *
TRADING_WINDOWS_UPDATE_CRON=*/5 * * * *
CACHE_CLEANUP_CRON=0 0 * * *

# --- Portfolio sync (включено для локальной разработки) ---
PORTFOLIO_SYNC_ENABLED=true
PORTFOLIO_SYNC_INTERVAL=300000
PORTFOLIO_AUTO_UPDATE_PRICES=true
PORTFOLIO_SYNC_HISTORY=true
USER_MAX_PORTFOLIO_BUDGET=1000000

# --- Trading / risk defaults ---
MAX_POSITION_SIZE=0.02
MAX_DRAWDOWN=0.15
MIN_CONFIDENCE=0.6
DISABLE_RATE_LIMIT=false
RATE_LIMIT_MAX=100000

# --- AI/ML background jobs ---
TRAINING_FULL_CRON=0 3 * * 1
TRAINING_QUICK_CRON=0 8,10,12,14,16,18 * * *
MARKET_ANALYSIS_CRON=0 * * * *
# LLM-жюри в анализе рынка: FIGI на один батч-промпт (несколько батчей за прогон при большом каталоге)
LLM_JURY_BATCH_SIZE=45
WEEKLY_GENERATION_CRON=0 8 * * *
WEEKLY_UPDATE_CRON=0 9 * * *
WEEKLY_TRAINING_CRON=0 4 * * 1
# In-memory реестр фоновых задач: периодически удалять записи со статусом completed
COMPLETED_TASKS_CLEANUP_CRON=0 * * * *

# --- Ops / cutover / Lightning ---
CUTOVER_BACKUP_DIR=./data/cutover_backups
CUTOVER_BACKUP_ROLLUP_PATH=./data/cutover_backups/cutover_backups.jsonl
CUTOVER_BACKUP_KEEP_RAW=5
LIGHTNING_LOGS_DIR=./lightning_logs
LIGHTNING_ROLLUP_PATH=./logs/lightning_runs.jsonl
LIGHTNING_KEEP_RAW=3

# --- Telegram (включено; без токена отправка не пойдёт) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- External providers (по необходимости) ---
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
# опциональное поле в Settings (см. config.py)
idencefier=

# --- Trading requests / dev ---
ALLOW_SYNTHETIC_TRADING_FIGI=true

# --- Paper MDP / exploration / pipeline ---
PAPER_MDP_LOG_ENABLED=true
PAPER_MDP_LOG_PATH=./logs/paper_mdp.jsonl
PAPER_EXPLORATION_ENABLED=false
PAPER_EXPLORATION_MAX_EXTRA=0
PAPER_EXPLORATION_MIN_SCORE=0.55
PAPER_EXPLORATION_ACTION=BUY
PAPER_PIPELINE_MIN_CONFIDENCE=0.35
PAPER_PIPELINE_MIN_SCORE=0.35
PAPER_SOFT_USE_DB_COLUMNS=true
PAPER_SOFT_HOLD_TO_BUY=false
PAPER_PIPELINE_MULTI_PROFILE=true

# --- Real vs paper calibration ---
REAL_SLIPPAGE_BPS=10
REAL_EXECUTION_DELAY_MS=0
REAL_CALIBRATION_LOG_ENABLED=true

# --- Optional broker / APIs ---
BROKER_HINT_AFTER_MANUAL_EXECUTE=false
RISK_REAL_CAP_PREVIEW_ENABLED=true
INDICATORS_API_ENABLED=true
PORTFOLIO_PROFILES_YAML_PATH=

# --- Audit & training artifacts ---
AUDIT_LOG_PATH=./logs/audit.jsonl
TRAINING_ALIGNMENT_DATASET_PATH=./data/training/alignment_dataset.jsonl
TRAINING_ALIGNMENT_CRON=0 5 * * 0
QUANT_RETURNS_MATRIX_CRON=0 3 * * *
VIRTUAL_PORTFOLIO_NAV_CRON=30 23 * * *

# Live read-only Tinkoff tests (pytest -m live_tinkoff): задайте TINKOFF_TOKEN и при необходимости TINKOFF_ACCOUNT_ID
