APP_NAME=ai-trader-fastapi
ENVIRONMENT=local
API_PREFIX=/api/v1
LOG_LEVEL=INFO
SERVER_TIMEZONE=Europe/Moscow
ERROR_REGISTRY_PATH=./logs/error_registry.json
RUNTIME_ERROR_LOG_PATH=./logs/runtime_errors.jsonl
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_trader
JWT_SECRET=change-me-development-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=7d
USER_PASSWORD=admin
TINKOFF_VERIFY_SSL=true
# Live read-only Tinkoff tests (pytest -m live_tinkoff)
# Required: TINKOFF_TOKEN
# Recommended: TINKOFF_ACCOUNT_ID (for portfolio/positions/operations tests)
CUTOVER_BACKUP_ROLLUP_PATH=./data/cutover_backups/cutover_backups.jsonl
CUTOVER_BACKUP_KEEP_RAW=5
LIGHTNING_LOGS_DIR=./lightning_logs
LIGHTNING_ROLLUP_PATH=./logs/lightning_runs.jsonl
LIGHTNING_KEEP_RAW=3
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
