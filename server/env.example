# ============================================================================
# НАСТРОЙКИ СЕРВЕРА
# ============================================================================
PORT=3001
NODE_ENV=development

# ============================================================================
# БАЗА ДАННЫХ
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_exchange
DB_USER=postgres
DB_PASSWORD=your_password

# ============================================================================
# ТИНЬКОФФ ИНВЕСТИЦИИ API
# ============================================================================
# Токен для доступа к API (получить в личном кабинете Тинькофф Инвестиции)
TINKOFF_TOKEN=your_tinkoff_token_here

# ID счета для торговли (получить через API или в личном кабинете)
TINKOFF_ACCOUNT_ID=your_account_id_here

# Базовый URL API (обычно не нужно менять)
TINKOFF_API_URL=https://invest-public-api.tinkoff.ru/rest

# ============================================================================
# TELEGRAM BOT (ОПЦИОНАЛЬНО)
# ============================================================================
# Токен бота для уведомлений
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ID чата для отправки уведомлений
TELEGRAM_CHAT_ID=your_chat_id

# ============================================================================
# НАСТРОЙКИ ТОРГОВЛИ
# ============================================================================
# Начальный капитал для виртуальной торговли (в рублях)
VIRTUAL_CAPITAL=1000000

# Максимальный размер позиции (% от капитала)
MAX_POSITION_SIZE=0.02

# Максимальная просадка (% от капитала)
MAX_DRAWDOWN=0.15

# Минимальная уверенность для сделки (0.0 - 1.0)
MIN_CONFIDENCE=0.6

# ============================================================================
# НАСТРОЙКИ БЕЗОПАСНОСТИ
# ============================================================================
# Секретный ключ для JWT токенов (сгенерировать случайную строку)
JWT_SECRET=your_jwt_secret_here

# Разрешенные домены для CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================================================
# NEWS API
# ============================================================================
# NewsAPI.org ключ для получения новостей (https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here