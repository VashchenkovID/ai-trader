{
  "name": "smart-exchange-server",
  "version": "1.0.0",
  "description": "Backend for Smart Exchange system",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "init-db": "node src/utils/initDatabase.js",
    "clear-db": "node src/utils/clearDatabase.js",
    "drop-db": "node src/utils/clearDatabase.js --drop-all",
    "reset-db": "node src/utils/clearDatabase.js --drop-all && node src/utils/initDatabase.js",
    "start:optimized": "node src/app-optimized.js",
    "start:backup": "node src/app-backup.js",
    "cleanup": "node cleanup-unused-files.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:backup": "node test-backup.js"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.15.0",
    "@xenova/transformers": "^2.17.2",
    "archiver": "^7.0.1",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "newsapi": "^2.4.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "node-telegram-bot-api": "^0.64.0",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "technicalindicators": "^3.1.0",
    "validator": "^13.11.0",
    "winston": "^3.17.0",
    "ws": "^8.14.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
